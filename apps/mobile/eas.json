{
  "cli": {
    "version": ">= 19.1.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "autoIncrement": "buildNumber"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true
    }
  }
}
