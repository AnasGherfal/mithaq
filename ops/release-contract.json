{
  "version": 1,
  "environments": {
    "preview": {
      "appEnv": "preview",
      "publicVariables": [
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY"
      ],
      "serverVariables": [],
      "serverSecrets": ["SUPABASE_SERVICE_ROLE_KEY"]
    },
    "staging": {
      "appEnv": "staging",
      "publicVariables": [
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY"
      ],
      "serverVariables": [
        "MITHAQ_CONVERSATION_RETENTION_DAYS",
        "MITHAQ_NOTIFICATION_RETENTION_DAYS"
      ],
      "serverSecrets": ["SUPABASE_SERVICE_ROLE_KEY"]
    },
    "production": {
      "appEnv": "production",
      "publicVariables": [
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "EXPO_PUBLIC_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY"
      ],
      "serverVariables": [
        "MITHAQ_CONVERSATION_RETENTION_DAYS",
        "MITHAQ_NOTIFICATION_RETENTION_DAYS"
      ],
      "serverSecrets": ["SUPABASE_SERVICE_ROLE_KEY"]
    }
  },
  "maintenanceWorkers": {
    "account_deletion": {
      "function": "account-deletion-worker",
      "maxIntervalMinutes": 60,
      "requiredBeforeRelease": true
    },
    "introduction_expiry": {
      "function": "introduction-expiry-worker",
      "maxIntervalMinutes": 15,
      "requiredBeforeRelease": true
    },
    "conversation_message_retention": {
      "function": "conversation-retention-worker",
      "maxIntervalMinutes": 1440,
      "requiredBeforeRelease": true
    },
    "notification_retention": {
      "function": "notification-retention-worker",
      "maxIntervalMinutes": 1440,
      "requiredBeforeRelease": true
    }
  },
  "releaseRequirements": {
    "separateSupabaseProjects": true,
    "separateEasEnvironments": true,
    "serviceRoleClientExposureForbidden": true,
    "databaseMigrationsRequired": true,
    "destructiveMigrationGuardRequired": true,
    "hostedEnvironmentPreflightRequired": true,
    "hostedReleaseVerificationRequired": true,
    "storeSubmissionReadinessRequired": true,
    "pgtapRequired": true,
    "mobileTypecheckRequired": true,
    "expoDoctorRequired": true,
    "productionE2eRequired": true,
    "maintenanceReadinessRequired": true,
    "releaseMetadataRequired": true,
    "privacySafeServerObservabilityRequired": true,
    "contentSecurityPolicyRequired": true,
    "disasterRecoveryRunbookRequired": true
  }
}
